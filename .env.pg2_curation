# Download this file as .env.pg2_curation beside install_pg2_curation.sh in
# PiGallery2's host config/extensions directory, then edit every deployment path.
# Values are parsed as data and are not executed as shell code.

# Existing Docker Compose deployment.
PG2_INSTALL_ROOT=/opt/pigallery2
PG2_CONTAINER=pigallery2
PG2_COMPOSE_DIR=/opt/pigallery2
PG2_COMPOSE_SERVICE=pigallery2

# Host installation destinations.
PG2_EXTENSION_DIR=/opt/pigallery2/config/extensions/curation-requests
PG2_CLI_DIR=/opt/pigallery2/curation/cli
PG2_CUSTOM_ASSETS_DIR=/opt/pigallery2/custom_assets
PG2_CONFIG_FILE=/opt/pigallery2/config/config.json

# Paths inside the PiGallery2 container.
PG2_CONTAINER_EXTENSION_DIR=/app/data/config/extensions/curation-requests
PG2_CONTAINER_CURATION_DIR=/app/data/curation
PG2_CONTAINER_IMAGE_DIR=/app/data/images
PG2_CONTAINER_ASSET_PATH=/app/dist/en/pg2-curation-script.js

# Extension settings written into PiGallery2 config.json.
PG2_EXTENSION_FOLDER=curation-requests
PG2_EXTENSION_DATABASE_PATH=/app/data/curation/curation.sqlite
PG2_EXTENSION_REQUESTER_ALLOWLIST=*
PG2_EXTENSION_COMMENT_MAX_LENGTH=4000

# Host-side Python CLI settings.
PG2_CURATION_DB=/opt/pigallery2/curation/curation.sqlite
PG2_PHOTO_ROOT=/srv/photos/family
PG2_SIDECAR_STYLE=none

# Installation behavior. No TypeScript compilation is performed. Production
# runtime dependencies are installed with the already-local PiGallery2 image.
PG2_INSTALL_DEPENDENCIES=true
PG2_RECREATE_CONTAINER=true
# Existing cli/.env is preserved unless this is explicitly true.
PG2_OVERWRITE_CLI_ENV=false
