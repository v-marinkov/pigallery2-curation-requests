# Copy this file to .env.deploy beside deploy-to-server.sh on a development workstation.
# Values are parsed as data, not executed as shell code.

# SSH destination. Use an SSH config alias if you need a non-default port or key.
PG2_DEPLOY_REMOTE=deploy-user@photos.example.net

# Host paths and Docker/Compose identity on the PiGallery2 server.
PG2_DEPLOY_BASE=/opt/pigallery2
PG2_DEPLOY_CONTAINER=pigallery2
PG2_DEPLOY_COMPOSE_DIR=/opt/pigallery2
PG2_DEPLOY_COMPOSE_SERVICE=pigallery2

# Override any derived host path when your layout differs.
PG2_DEPLOY_EXTENSION_DIR=/opt/pigallery2/config/extensions/request-deletions
PG2_DEPLOY_CLI_DIR=/opt/pigallery2/curation/cli
PG2_DEPLOY_CUSTOM_ASSETS_DIR=/opt/pigallery2/custom_assets
PG2_DEPLOY_CONFIG_FILE=/opt/pigallery2/config/config.json

# Extension path inside the PiGallery2 container.
PG2_DEPLOY_CONTAINER_EXTENSION_DIR=/app/data/config/extensions/request-deletions
PG2_DEPLOY_CONTAINER_CURATION_DIR=/app/data/curation
PG2_DEPLOY_CONTAINER_IMAGE_DIR=/app/data/images
PG2_DEPLOY_CONTAINER_ASSET_PATH=/app/dist/en/custom-scripts.js

# Recreate from Compose so newly added locale asset mounts take effect.
PG2_DEPLOY_RECREATE_CONTAINER=true

# Recommended for first installs and upgrades. This installs package-lock.json
# production dependencies using the same image/architecture as PiGallery2.
PG2_DEPLOY_INSTALL_DEPENDENCIES=true
