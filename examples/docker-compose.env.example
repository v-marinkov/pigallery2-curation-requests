# Copy to .env beside docker-compose.yml on the PiGallery2 server.
PG2_CONTAINER_NAME=pigallery2
PG2_CONFIG_DIR=/opt/pigallery2/config
PG2_DATABASE_DIR=/opt/pigallery2/db
PG2_TEMP_DIR=/opt/pigallery2/tmp
PG2_CURATION_DIR=/opt/pigallery2/curation
PG2_CUSTOM_ASSETS_DIR=/opt/pigallery2/custom_assets
PG2_PHOTO_LIBRARY=/srv/photos/family
PG2_HTTP_PORT=8080
